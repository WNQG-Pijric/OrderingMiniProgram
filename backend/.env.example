# 环境变量模板：复制为 .env 并填写实际值（.env 已被 .gitignore 忽略）

# MySQL 连接串（本地 Docker：restaurant-mysql）
DATABASE_URL="mysql://root:restaurant_dev@localhost:3306/restaurant"

# JWT 密钥（用 `openssl rand -hex 32` 生成）
JWT_SECRET=""
JWT_REFRESH_SECRET=""

# 微信小程序（模块 01 时填写；AppSecret 仅存后端）
WECHAT_APPID=""
WECHAT_SECRET=""

# 腾讯云 COS（模块 03 图片直传；密钥仅存后端，临时密钥签发后给小程序）
# 控制台创建存储桶后填写：COS_SECRET_ID / COS_SECRET_KEY（API 密钥）、COS_BUCKET（桶名）、COS_REGION（园区）
COS_SECRET_ID=""
COS_SECRET_KEY=""
COS_BUCKET=""
COS_REGION=""
# 小程序直传允许的前缀（默认 menu/，即只允许上传菜品图片）
COS_ALLOW_PREFIX="menu/"
