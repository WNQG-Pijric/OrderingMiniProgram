<view class="page">
  <!-- 顶部：标题 + 个人中心入口 -->
  <view class="header">
    <text class="header__title">点餐</text>
    <text class="header__entry" bindtap="goProfile">我的</text>
  </view>

  <!-- 公告位：模块 09 首页顶部展示 -->
  <view class="notice-placeholder"></view>

  <!-- 分类 tab -->
  <scroll-view class="tabs" scroll-x enable-flick>
    <view
      class="tab {{activeCategoryId === 0 ? 'tab--active' : ''}}"
      data-id="0"
      bindtap="onCategoryTap"
    >全部</view>
    <view
      wx:for="{{categories}}"
      wx:key="id"
      class="tab {{activeCategoryId === item.id ? 'tab--active' : ''}}"
      data-id="{{item.id}}"
      bindtap="onCategoryTap"
    >{{item.name}}</view>
  </scroll-view>

  <!-- 菜品列表 -->
  <view class="menu-list">
    <view wx:if="{{loading}}" class="c-empty">加载中...</view>
    <view wx:elif="{{menus.length === 0}}" class="c-empty">暂无菜品</view>
    <view
      wx:for="{{menus}}"
      wx:key="id"
      class="menu-item"
      data-id="{{item.id}}"
      bindtap="goDetail"
    >
      <image wx:if="{{item.image}}" class="menu-item__img" src="{{item.image}}" mode="aspectFill" />
      <view wx:else class="menu-item__img menu-item__img--placeholder"></view>
      <view class="menu-item__info">
        <text class="menu-item__name">{{item.name}}</text>
        <text wx:if="{{item.description}}" class="menu-item__desc c-ellipsis">{{item.description}}</text>
        <view class="menu-item__bottom">
          <text class="c-price">{{item.price}}</text>
          <text wx:if="{{item.isSpec}}" class="c-tag">多规格</text>
        </view>
      </view>
    </view>
  </view>
</view>
