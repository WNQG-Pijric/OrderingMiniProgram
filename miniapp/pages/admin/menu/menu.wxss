/* 菜单管理 */
.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}

.toolbar {
  background: #fff;
  padding: 24rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.filters {
  display: flex;
}

.filter {
  margin-right: 16rpx;
  padding: 10rpx 24rpx;
  border-radius: 28rpx;
  font-size: 28rpx;
  color: #666;
  background: #f5f5f5;
}

.filter.active {
  color: #fff;
  background: #ff9f43;
}

.ops {
  display: flex;
  align-items: center;
}

.link-btn {
  font-size: 26rpx;
  color: #576b95;
  margin-right: 20rpx;
}

.add-btn {
  background: #ff9f43;
  color: #fff;
  font-size: 26rpx;
  padding: 0 28rpx;
  line-height: 60rpx;
  border-radius: 30rpx;
  margin: 0;
}

.tip,
.end-tip {
  text-align: center;
  color: #999;
  padding: 80rpx 0;
  font-size: 28rpx;
}

.end-tip {
  padding: 24rpx 0;
  font-size: 24rpx;
}

.list {
  padding: 24rpx 32rpx;
}

.item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.placeholder {
  background: #eee;
}

.info {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
}

.name {
  font-size: 30rpx;
  font-weight: 500;
}

.name.disabled {
  color: #999;
  text-decoration: line-through;
}

.meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999;
}

.spec {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #ff9f43;
}

.op-btn {
  margin-left: 20rpx;
  font-size: 28rpx;
  color: #576b95;
}

.op-btn.danger {
  color: #ff4d2e;
}
