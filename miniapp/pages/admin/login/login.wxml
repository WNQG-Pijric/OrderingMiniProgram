<view class="page">
  <view class="logo">管理员登录</view>
  <view class="form">
    <input
      class="input"
      placeholder="账号"
      value="{{username}}"
      data-field="username"
      bindinput="onInput"
    />
    <input
      class="input"
      placeholder="密码"
      password
      value="{{password}}"
      data-field="password"
      bindinput="onInput"
    />
    <button class="login-btn" loading="{{loading}}" bindtap="onLogin">
      登录
    </button>
  </view>
</view>
