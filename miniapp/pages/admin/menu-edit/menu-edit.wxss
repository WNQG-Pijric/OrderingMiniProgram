/* 菜品新增 / 编辑 */
.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 24rpx 32rpx 60rpx;
}

.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 32rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
}

.section-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999;
}

.field {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.field:last-child {
  border-bottom: none;
}

.label {
  width: 200rpx;
  font-size: 28rpx;
  color: #333;
  flex-shrink: 0;
}

.input {
  flex: 1;
  font-size: 30rpx;
}

.picker {
  flex: 1;
  font-size: 30rpx;
}

.picker.placeholder {
  color: #999;
}

/* 图片 */
.image-box {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
}

.preview {
  width: 240rpx;
  height: 240rpx;
  border-radius: 12rpx;
}

.empty {
  border: 2rpx dashed #ccc;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
  font-size: 28rpx;
}

.uploading {
  background: #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
  font-size: 26rpx;
}

.remove-img {
  margin-left: 24rpx;
  font-size: 26rpx;
  color: #ff4d2e;
}

/* 规格 */
.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.add-group {
  font-size: 28rpx;
  color: #ff9f43;
}

.group {
  margin-top: 24rpx;
  background: #fafafa;
  border-radius: 12rpx;
  padding: 20rpx;
}

.group-head {
  display: flex;
  align-items: center;
}

.group-name {
  background: #fff;
  border: 1rpx solid #eee;
  border-radius: 8rpx;
  padding: 12rpx 16rpx;
}

.remove-group {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #ff4d2e;
  flex-shrink: 0;
}

.item-row {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.item-name {
  flex: 1;
  background: #fff;
  border: 1rpx solid #eee;
  border-radius: 8rpx;
  padding: 12rpx 16rpx;
}

.item-price {
  width: 140rpx;
  margin-left: 16rpx;
  background: #fff;
  border: 1rpx solid #eee;
  border-radius: 8rpx;
  padding: 12rpx 16rpx;
}

.remove-item {
  margin-left: 12rpx;
  font-size: 32rpx;
  color: #999;
  padding: 0 8rpx;
}

.add-item {
  display: inline-block;
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #576b95;
}

.save-btn {
  background: #ff9f43;
  color: #fff;
  font-size: 32rpx;
  border-radius: 44rpx;
  margin-top: 16rpx;
}
