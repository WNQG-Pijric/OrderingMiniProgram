<view class="page">
  <view class="toolbar">
    <button class="c-btn c-btn--primary c-btn--sm add-btn" bindtap="onAdd">新增分类</button>
  </view>

  <view wx:if="{{loading}}" class="c-empty">加载中...</view>
  <view wx:elif="{{list.length === 0}}" class="c-empty">暂无分类</view>

  <view class="list">
    <view wx:for="{{list}}" wx:key="id" class="c-card item">
      <view class="item__info">
        <text class="item__name {{item.status === 0 ? 'item__name--disabled' : ''}}">{{item.name}}</text>
        <text class="item__sort">排序 {{item.sort}}</text>
      </view>
      <view class="item__ops">
        <!-- switch color 与主色 token 一致（组件属性不支持 CSS 变量） -->
        <switch
          checked="{{item.status === 1}}"
          color="#ff9f43"
          data-id="{{item.id}}"
          data-status="{{item.status}}"
          bindchange="onToggleStatus"
        />
        <text class="op-btn" data-item="{{item}}" bindtap="onEdit">编辑</text>
        <text class="op-btn op-btn--danger" data-id="{{item.id}}" data-name="{{item.name}}" bindtap="onDelete">删除</text>
      </view>
    </view>
  </view>

  <!-- 新增/编辑弹层 -->
  <view wx:if="{{showForm}}" class="mask" bindtap="onFormCancel">
    <view class="form-panel" catchtap="noop">
      <text class="form-title">{{form.id ? '编辑分类' : '新增分类'}}</text>
      <input
        class="form__input"
        placeholder="分类名称"
        value="{{form.name}}"
        data-field="name"
        bindinput="onFormInput"
      />
      <input
        class="form__input"
        type="number"
        placeholder="排序（越小越靠前）"
        value="{{form.sort}}"
        data-field="sort"
        bindinput="onFormInput"
      />
      <view class="form-ops">
        <button class="c-btn form-cancel" bindtap="onFormCancel">取消</button>
        <button class="c-btn c-btn--primary form-save" bindtap="onFormSave">保存</button>
      </view>
    </view>
  </view>
</view>
