/* 分类管理 */
.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}

.toolbar {
  padding: 24rpx 32rpx;
}

.add-btn {
  background: #ff9f43;
  color: #fff;
  font-size: 30rpx;
  border-radius: 44rpx;
}

.tip {
  text-align: center;
  color: #999;
  padding: 80rpx 0;
  font-size: 28rpx;
}

.list {
  padding: 0 32rpx;
}

.item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.info {
  display: flex;
  flex-direction: column;
}

.name {
  font-size: 32rpx;
  font-weight: 500;
}

.name.disabled {
  color: #999;
  text-decoration: line-through;
}

.sort {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999;
}

.ops {
  display: flex;
  align-items: center;
}

.op-btn {
  margin-left: 24rpx;
  font-size: 28rpx;
  color: #576b95;
}

.op-btn.danger {
  color: #ff4d2e;
}

/* 弹层表单 */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.form-panel {
  width: 600rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx;
}

.form-title {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 32rpx;
}

.input {
  border: 1rpx solid #ddd;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
  font-size: 30rpx;
}

.form-ops {
  display: flex;
  justify-content: space-between;
  margin-top: 16rpx;
}

.btn {
  flex: 1;
  font-size: 30rpx;
  border-radius: 44rpx;
}

.btn.cancel {
  margin-right: 24rpx;
  background: #f0f0f0;
  color: #333;
}

.btn.save {
  background: #ff9f43;
  color: #fff;
}
