/* 菜品详情：选规格 + 数量 + 计价 */
.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 140rpx;
}

.menu-header {
  display: flex;
  background: #fff;
  padding: 32rpx;
}

.menu-img {
  width: 220rpx;
  height: 220rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.placeholder {
  background: #eee;
}

.menu-title {
  flex: 1;
  margin-left: 32rpx;
  display: flex;
  flex-direction: column;
}

.menu-name {
  font-size: 40rpx;
  font-weight: 600;
}

.menu-desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #999;
}

.menu-price {
  margin-top: auto;
  font-size: 40rpx;
  color: #ff4d2e;
  font-weight: 600;
}

/* 规格 */
.spec-section {
  margin-top: 20rpx;
  background: #fff;
  padding: 32rpx;
}

.spec-group {
  margin-bottom: 32rpx;
}

.spec-group-name {
  font-size: 30rpx;
  font-weight: 500;
}

.spec-items {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
}

.spec-item {
  display: flex;
  align-items: center;
  padding: 12rpx 24rpx;
  margin: 0 16rpx 16rpx 0;
  background: #f5f5f5;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
}

.spec-item.active {
  background: #fff3e6;
  color: #ff9f43;
  border: 1rpx solid #ff9f43;
}

.spec-price {
  margin-left: 8rpx;
  font-size: 24rpx;
  color: #ff4d2e;
}

.no-spec {
  font-size: 26rpx;
  color: #999;
}

/* 底部固定栏 */
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  display: flex;
  align-items: center;
  padding: 20rpx 32rpx;
  border-top: 1rpx solid #eee;
}

.count-box {
  display: flex;
  align-items: center;
}

.count-btn {
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  text-align: center;
  border: 1rpx solid #ddd;
  border-radius: 50%;
  font-size: 36rpx;
}

.count-btn.disabled {
  color: #ccc;
}

.count {
  min-width: 80rpx;
  text-align: center;
  font-size: 32rpx;
}

.total {
  flex: 1;
  text-align: right;
  font-size: 40rpx;
  color: #ff4d2e;
  font-weight: 600;
  margin-right: 24rpx;
}

.cart-btn {
  background: #ff9f43;
  color: #fff;
  font-size: 30rpx;
  padding: 18rpx 48rpx;
  border-radius: 44rpx;
}
