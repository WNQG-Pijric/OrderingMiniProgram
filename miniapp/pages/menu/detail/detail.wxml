<view class="page" wx:if="{{menu}}">
  <!-- 菜品信息 -->
  <view class="menu-header">
    <image wx:if="{{menu.image}}" class="menu-header__img" src="{{menu.image}}" mode="aspectFill" />
    <view wx:else class="menu-header__img menu-header__img--placeholder"></view>
    <view class="menu-header__info">
      <text class="menu-header__name">{{menu.name}}</text>
      <text wx:if="{{menu.description}}" class="menu-header__desc">{{menu.description}}</text>
      <text class="c-price menu-header__price">{{menu.price}}</text>
    </view>
  </view>

  <!-- 规格选择：每组单选一项 -->
  <view class="spec-section">
    <view wx:for="{{menu.specGroups}}" wx:key="id" wx:for-item="group" class="spec-group">
      <text class="spec-group__name">{{group.name}}</text>
      <view class="spec-group__items">
        <view
          wx:for="{{group.items}}"
          wx:key="id"
          wx:for-item="item"
          class="spec-item {{selections[group.id] === item.id ? 'spec-item--active' : ''}}"
          data-group-id="{{group.id}}"
          data-item-id="{{item.id}}"
          bindtap="onSpecTap"
        >
          <text>{{item.name}}</text>
          <text wx:if="{{item.priceDelta !== '0.00'}}" class="spec-item__price">+¥{{item.priceDelta}}</text>
        </view>
      </view>
    </view>
    <view wx:if="{{!menu.specGroups || menu.specGroups.length === 0}}" class="spec-section__empty">
      无规格，直接购买
    </view>
  </view>

  <!-- 底部固定栏：数量 + 总价 + 加入购物车（售罄时全禁用） -->
  <view class="footer">
    <view class="count-box">
      <view class="count-btn {{count <= 1 || soldOut ? 'count-btn--disabled' : ''}}" bindtap="onMinus">-</view>
      <text class="count-box__num">{{count}}</text>
      <view class="count-btn {{count >= menu.stock || soldOut ? 'count-btn--disabled' : ''}}" bindtap="onPlus">+</view>
    </view>
    <text class="c-price footer__total">{{totalPrice}}</text>
    <text wx:if="{{soldOut}}" class="footer__soldout">已售罄</text>
    <view class="c-btn c-btn--primary footer__cart {{soldOut ? 'c-btn--disabled' : ''}}" bindtap="addToCart">{{soldOut ? '已售罄' : (isEdit ? '保存修改' : '加入购物车')}}</view>
  </view>
</view>
