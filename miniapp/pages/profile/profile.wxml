<view class="container">
  <!-- 用户信息卡片 -->
  <view class="c-card card">
    <image
      wx:if="{{user.avatar}}"
      class="card__avatar"
      src="{{user.avatar}}"
      mode="aspectFill"
    />
    <view wx:else class="card__avatar card__avatar--placeholder">无</view>
    <view class="card__info">
      <text class="card__nickname">{{user.nickname || '微信用户'}}</text>
      <text class="card__role">{{user.role === 'ADMIN' ? '管理员' : '用户'}}</text>
    </view>
  </view>

  <!-- 钱包入口 -->
  <view class="c-card menu" bindtap="goWallet">
    <text>我的钱包</text>
    <text class="c-text-tertiary">余额 ¥{{user.balance || '0.00'}} ›</text>
  </view>

  <!-- 管理员入口（模块 03：菜单 / 分类管理） -->
  <view class="c-card menu" bindtap="goAdmin">
    <text>管理员端</text>
    <text class="c-text-tertiary">菜单 / 分类管理 ›</text>
  </view>

  <!-- 查看态：编辑按钮 -->
  <button
    wx:if="{{!editing}}"
    class="c-btn c-btn--primary c-btn--block edit-btn"
    bindtap="startEdit"
  >
    编辑资料
  </button>

  <!-- 编辑态：昵称 / 头像 URL -->
  <view wx:else class="c-card form">
    <input
      class="form__input"
      placeholder="昵称（最多 30 字）"
      value="{{nickname}}"
      maxlength="30"
      bindinput="onNicknameInput"
    />
    <input
      class="form__input"
      placeholder="头像 URL（可选，模块 03 支持图片直传）"
      value="{{avatar}}"
      bindinput="onAvatarInput"
    />
    <view class="form__actions">
      <button class="c-btn cancel" bindtap="cancelEdit">取消</button>
      <button
        class="c-btn c-btn--primary save"
        loading="{{saving}}"
        bindtap="saveProfile"
      >
        保存
      </button>
    </view>
  </view>
</view>
