.container {
  padding: 40rpx 30rpx;
}

.card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #eee;
  color: #999;
  font-size: 28rpx;
}

.info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.nickname {
  font-size: 36rpx;
  font-weight: 600;
}

.role {
  font-size: 24rpx;
  color: #999;
}

.menu {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx 40rpx;
  margin-top: 24rpx;
  font-size: 30rpx;
}

.arrow {
  color: #888;
}

.edit-btn {
  margin-top: 40rpx;
}

.form {
  margin-top: 40rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
}

.input {
  height: 88rpx;
  border-bottom: 1rpx solid #f0f0f0;
  font-size: 30rpx;
  padding: 0 8rpx;
}

.form-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 32rpx;
}

.cancel {
  flex: 1;
  background: #f0f0f0;
  color: #333;
}

.save {
  flex: 1;
}
