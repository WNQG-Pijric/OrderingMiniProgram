.container {
  padding: 30rpx;
}

.balance-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  background: linear-gradient(135deg, #ff8c42, #ff6a3d);
  border-radius: 20rpx;
  padding: 60rpx 40rpx;
  color: #fff;
}

.label {
  font-size: 26rpx;
  opacity: 0.9;
}

.amount {
  font-size: 72rpx;
  font-weight: 700;
}

.section-title {
  margin: 40rpx 8rpx 20rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.empty {
  text-align: center;
  color: #999;
  padding: 80rpx 0;
  font-size: 28rpx;
}

.log-list {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.log-item {
  display: flex;
  justify-content: space-between;
  padding: 26rpx 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.log-left {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.log-type {
  font-size: 30rpx;
  font-weight: 500;
}

.log-remark {
  font-size: 24rpx;
  color: #999;
}

.log-time {
  font-size: 22rpx;
  color: #bbb;
}

.log-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx;
}

.log-change {
  font-size: 32rpx;
  font-weight: 600;
}

.log-change.plus {
  color: #07c160;
}

.log-change.minus {
  color: #e64340;
}

.log-after {
  font-size: 22rpx;
  color: #bbb;
}

.load-more {
  text-align: center;
  color: #999;
  font-size: 24rpx;
  padding: 30rpx 0;
}
