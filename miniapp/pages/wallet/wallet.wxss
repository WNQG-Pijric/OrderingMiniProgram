/* 我的钱包 —— token 见 app.wxss / common.wxss（docs/design.md） */
.container {
  padding: var(--space-xl) var(--space-lg);
}

/* 余额卡片 */
.balance-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-sm);
  background: linear-gradient(135deg, var(--color-primary-active), var(--color-primary-deep));
  border-radius: var(--radius-xl);
  padding: var(--space-5xl) var(--space-3xl);
  color: #ffffff;
}
.balance-card__label {
  font-size: var(--font-size-body-sm);
  opacity: 0.9;
}
.balance-card__amount {
  font-size: var(--font-size-display);
  font-weight: 700;
}

/* 收支明细 */
.section-title {
  margin: var(--space-3xl) var(--space-xs) var(--space-lg);
  font-size: var(--font-size-body-lg);
  font-weight: 600;
  color: var(--text-primary);
}
.log-list {
  background-color: var(--bg-card);
  border-radius: var(--radius-lg);
  overflow: hidden;
}
.log-item {
  display: flex;
  justify-content: space-between;
  padding: var(--space-lg) var(--space-xl);
  border-bottom: 2rpx solid var(--border-color);
}
.log-item:last-child {
  border-bottom: none;
}
.log-item__left {
  display: flex;
  flex-direction: column;
  gap: 6rpx; /* 微调间隙（docs/design.md 例外说明） */
}
.log-item__type {
  font-size: var(--font-size-body-lg);
  font-weight: 500;
  color: var(--text-primary);
}
.log-item__remark {
  font-size: var(--font-size-small);
  color: var(--text-placeholder);
}
.log-item__time {
  font-size: var(--font-size-tag);
  color: var(--text-tertiary);
}
.log-item__right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx; /* 微调间隙 */
}
.log-item__change {
  font-size: var(--font-size-title-sm);
  font-weight: 600;
}
.log-item__change--plus {
  color: var(--color-success);
}
.log-item__change--minus {
  color: var(--color-danger);
}
.log-item__after {
  font-size: var(--font-size-tag);
  color: var(--text-tertiary);
}

/* 加载提示 */
.load-more {
  text-align: center;
  color: var(--text-placeholder);
  font-size: var(--font-size-small);
  padding: var(--space-xl) 0;
}
